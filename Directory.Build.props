<Project>
  <!--
    Keep every generated file out of the source tree.

    By default the .NET SDK writes obj\ and bin\ next to the .csproj. For a
    self-contained WinUI 3 app that is several hundred megabytes of .NET runtime and
    Windows App SDK sitting in src\, mixed in with the sources.

    Set here rather than on the MSBuild command line so that it applies however the
    project is built - through CMake, through `dotnet build`, or from Visual Studio -
    and so that all three land in the same place.

    Directory.Build.props is imported at the very top of Microsoft.Common.props, which
    is early enough for NuGet: restore resolves the assets file through
    MSBuildProjectExtensionsPath, which defaults to BaseIntermediateOutputPath. Setting
    BaseIntermediateOutputPath inside the .csproj itself would be too late.

    CMakeLists.txt mirrors these paths in MCS_ARTIFACT_ROOT; keep the two in step.

    The .csproj condition is load-bearing, not tidiness. Directory.Build.props is picked
    up by *every* project underneath it, including the .vcxproj files CMake generates into
    build\ - and CMake names its custom target after the project, so $(MSBuildProjectName)
    is "MoveCopyScrap" for both. Without the condition the two share one obj\ folder, the
    C++ project finds the C# project's project.assets.json there, looks for a C++ target
    framework inside it and fails with:

        Microsoft.NuGet.targets(198,5): error : Sequence contains no elements
           at Microsoft.NuGet.Build.Tasks.ResolveNuGetPackageAssets.GiveErrorForMissingFramework()
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
